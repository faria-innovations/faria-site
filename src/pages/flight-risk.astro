---
// Flight Risk has moved to Faria Innovations Media. This route now
// redirects to the standalone Flight Risk site. Kept as a redirect (not a
// dead page) and intentionally not linked from navigation.
const target = 'https://flightriskshow.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={target} />
    <title>Redirecting to Flight Risk…</title>
    <script type="text/javascript" set:html={`location.replace(${JSON.stringify(target)});`}></script>
  </head>
  <body>
    <p>Flight Risk has moved. Redirecting to <a href={target}>flightriskshow.com</a>…</p>
  </body>
</html>
