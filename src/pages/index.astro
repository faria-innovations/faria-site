---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMarker from '../components/SectionMarker.astro';
import LabsCartographMap from '../components/LabsCartographMap.astro';
import ParcelMap from '../components/ParcelMap.astro';
import { ventures } from '../data/ventures';
import { labs } from '../data/labs';
import { site } from '../data/site';
---

<BaseLayout
  title="Faria Innovations — Venture Index"
  description="Faria Innovations indexes Parcentry, Flight Risk, Labs, and future work by Felipe Alves Faria."
>
  <section class="registry-meta">
    <dl class="container registry-fields">
      <div class="registry-field"><dt>FILE</dt><dd>{site.legalName}</dd></div>
      <div class="registry-field"><dt>TYPE</dt><dd>PARENT COMPANY / VENTURE INDEX</dd></div>
      <div class="registry-field"><dt>INDEX</dt><dd>PARCENTRY / FLIGHT RISK / LABS</dd></div>
      <div class="registry-field"><dt>LOCATION</dt><dd>BELTSVILLE, MARYLAND</dd></div>
      <div class="registry-field"><dt>LAST FILED</dt><dd>{site.lastUpdated}</dd></div>
    </dl>
  </section>

  <section class="parcentry-hero" id="parcentry-hero" aria-labelledby="parcentry-hero-title">
    <div class="container parcentry-hero-grid">
      <div class="parcentry-hero-main">
        <p class="parcentry-hero-category">
          <span class="accent-tick">▍</span>
          <span>COMMERCIAL REAL ESTATE SOFTWARE</span>
          <span>VENTURE 01 / ACTIVE PRODUCT</span>
        </p>
        <h2 class="parcentry-hero-title" id="parcentry-hero-title">PARCENTRY</h2>
        <p class="parcentry-hero-lead">
          Track public-record changes across commercial properties.
        </p>
        <p class="parcentry-hero-benefit">
          Know the moment a sale, lien, ownership transfer, permit filing, or zoning change hits the properties you care about.
        </p>
        <div class="parcentry-hero-ctas">
          <a class="cta" href="mailto:felipe@fariainnovations.com?subject=Parcentry%20Demo%20Request">Request Demo</a>
          <a class="cta cta--ghost" href="/parcentry/">View Sample Report&nbsp;→</a>
        </div>
      </div>
      <aside class="parcentry-hero-proof" aria-label="Operational proof">
        <p class="proof-label">
          <span class="accent-tick" aria-hidden="true">▍</span>
          <span>OPERATIONAL PROOF</span>
        </p>
        <ul class="proof-list" role="list">
          <li>281,476 parcels indexed</li>
          <li>Nightly scans</li>
          <li>Public records monitored</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="ventures-section" id="ventures" aria-labelledby="ventures-label">
    <div class="container dossier-grid">
      <aside class="dossier-opener">
        <span class="dossier-numeral" aria-hidden="true">01</span>
        <p class="dossier-opener-label" id="ventures-label">INDEX OF VENTURES</p>
      </aside>

      <ol class="venture-list" role="list">
        {
          ventures.map((v) => (
            <li class={`venture-row venture-row--${v.atmosphere ?? 'standard'}`}>
              <div class="venture-head">
                <p class="venture-category">{v.category}</p>
                <h3 class="venture-name">
                  <a href={v.entry}>{v.name}</a>
                </h3>
                <p class="venture-desc">{v.description}</p>
              </div>

              <ul class="venture-signals" role="list">
                {v.signals.map((s) => (
                  <li class="venture-signal">{s.label}</li>
                ))}
              </ul>

              {v.graphic === 'parcel-map' && (
                <div class="venture-graphic">
                  <ParcelMap />
                </div>
              )}

              <dl class="venture-metadata">
                {v.metadata.map((m) => (
                  <div class="venture-metadata-row">
                    <dt>{m.key}</dt>
                    <dd>{m.value}</dd>
                  </div>
                ))}
              </dl>

              <div class="venture-links">
                <a href={v.entry}>entry →</a>
                {v.external && (
                  <a href={v.external.href} rel="noopener">{v.external.label}</a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="labs" aria-labelledby="labs-label">
    <div class="container">
      <SectionMarker num="02" label="LABS · WORKING FIELD" id="labs-label" />
      <div class="labs-list">
        {
          labs.map((lab) => (
            <details class="lab-row">
              <summary class="lab-summary">
                <span class="lab-prefix">{lab.prefix}</span>
                <span class="lab-sep" aria-hidden="true">—</span>
                <span class="lab-name">{lab.name}</span>
                <span class="lab-sep" aria-hidden="true">—</span>
                <span class="lab-desc">{lab.description}</span>
              </summary>
              <p class="lab-extra">{lab.expanded}</p>
              {lab.cartograph && <LabsCartographMap />}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-label">
    <div class="container">
      <SectionMarker num="03" label="ABOUT" id="about-label" />
      <div class="plain-block">
        <p>Faria Innovations is operated by Felipe Alves Faria.</p>
        <p>Beltsville, Maryland.</p>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-label">
    <div class="container">
      <SectionMarker num="04" label="CONTACT" id="contact-label" />
      <div class="plain-block">
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={site.phoneHref}>{site.phone}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
