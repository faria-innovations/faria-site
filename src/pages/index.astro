---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMarker from '../components/SectionMarker.astro';
import LabsCartographMap from '../components/LabsCartographMap.astro';
import { ventures } from '../data/ventures';
import { labs } from '../data/labs';
import { site } from '../data/site';
---

<BaseLayout
  title="Faria Innovations — Software and Data Ventures"
  description="Faria Innovations builds and operates commercial software, data systems, and experimental technology ventures."
>
  <!-- ===================== HERO (single column) ===================== -->
  <section class="tech-hero" id="top" aria-labelledby="tech-hero-h1">
    <div class="container tech-hero-grid2">
      <div class="tech-hero-copy">
        <p class="tech-eyebrow">FARIA INNOVATIONS LLC · TECHNOLOGY COMPANY</p>
        <h1 class="tech-h1" id="tech-hero-h1">Software and data ventures built to operate.</h1>
        <p class="tech-lede">
          Faria Innovations builds and operates commercial software, data systems, and early-stage technology ventures.
        </p>
        <div class="tech-cta-row">
          <a class="cta" href="#products">View Products&nbsp;→</a>
          <a class="tech-textlink" href="#contact">Partnership / Investor Inquiries</a>
        </div>
      </div>

      <figure class="tech-shot tech-hero-figure">
        <img
          src="/assets/parcentry-dashboard.png"
          width="1600"
          height="903"
          alt="Parcentry dashboard showing commercial-property monitoring and public-record intelligence."
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>Parcentry dashboard — active commercial software.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== PROOF STRIP ===================== -->
  <section class="tech-proof" aria-label="Operating signals">
    <div class="container">
      <ul class="tech-proof-list" role="list">
        <li class="tech-proof-item"><span class="tech-proof-num">281K+</span><span class="tech-proof-label">Parcels indexed</span></li>
        <li class="tech-proof-item"><span class="tech-proof-num">Nightly</span><span class="tech-proof-label">Public-record scans</span></li>
        <li class="tech-proof-item"><span class="tech-proof-num">Active</span><span class="tech-proof-label">Commercial product</span></li>
        <li class="tech-proof-item"><span class="tech-proof-num">Ongoing</span><span class="tech-proof-label">Technology experiments</span></li>
      </ul>
    </div>
  </section>

  <!-- ===================== PRODUCTS & VENTURES ===================== -->
  <section class="section" id="products" aria-labelledby="products-label">
    <div class="container">
      <SectionMarker num="01" label="CURRENT PRODUCTS & VENTURES" id="products-label" />
      <p class="section-intro">
        Faria builds focused technology ventures around operational problems and repeatable systems.
      </p>
      <ol class="venture-list" role="list">
        {
          ventures.map((v) => (
            <li class="venture-row">
              <div class="venture-head">
                <p class="venture-category">{v.category}</p>
                <h2 class="venture-name">{v.name}</h2>
                <p class="venture-desc">{v.description}</p>
              </div>
              {v.shot && (
                <figure class="venture-shot">
                  <img src={v.shot.src} width="1600" height="903" alt={v.shot.alt} decoding="async" loading="lazy" />
                  {v.shot.caption && <figcaption>{v.shot.caption}</figcaption>}
                </figure>
              )}
              <dl class="venture-stage"><dt>STAGE</dt><dd>{v.stage}</dd></dl>
              {v.proof && v.proof.length > 0 && (
                <ul class="venture-proof" role="list">{v.proof.map((p) => <li>{p}</li>)}</ul>
              )}
              {(v.cta || v.demo) && (
                <div class="venture-actions">
                  {v.cta &&
                    (v.cta.external ? (
                      <a class="cta venture-cta" href={v.cta.href} target="_blank" rel="noopener noreferrer">{v.cta.label}</a>
                    ) : (
                      <a class="cta venture-cta" href={v.cta.href}>{v.cta.label}</a>
                    ))}
                  {v.demo && (
                    <a class="tech-textlink venture-demo" href={v.demo.href}>{v.demo.label}</a>
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== TECHNICAL CAPABILITY ===================== -->
  <section class="section" id="capability" aria-labelledby="capability-label">
    <div class="container">
      <SectionMarker num="02" label="TECHNICAL CAPABILITY" id="capability-label" />
      <ul class="capability-list" role="list">
        <li>Property-level monitoring</li>
        <li>Change detection across public records</li>
        <li>Active product iteration</li>
        <li>Internal prototype development</li>
      </ul>
    </div>
  </section>

  <!-- ===================== LABS ===================== -->
  <section class="section section--alt" id="labs" aria-labelledby="labs-label">
    <div class="container">
      <SectionMarker num="03" label="LABS" id="labs-label" />
      <p class="section-intro">
        Labs contains internal prototypes, technical experiments, and working systems that may become future ventures.
      </p>
      <div class="labs-list">
        {
          labs.map((lab) => (
            <details class="lab-row">
              <summary class="lab-summary">
                <span class="lab-prefix">{lab.prefix}</span>
                <span class="lab-sep" aria-hidden="true">—</span>
                <span class="lab-name">{lab.name}</span>
                <span class="lab-sep" aria-hidden="true">—</span>
                <span class="lab-desc">{lab.description}</span>
              </summary>
              <p class="lab-extra">{lab.expanded}</p>
              {lab.cartograph && <LabsCartographMap />}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section class="section" id="about" aria-labelledby="about-label">
    <div class="container">
      <SectionMarker num="04" label="ABOUT" id="about-label" />
      <div class="plain-block">
        <p>Faria Innovations is operated by Felipe Alves Faria.</p>
        <p>The company builds and houses software, data systems, and experimental technology ventures.</p>
        <p>Current work includes Parcentry and Labs.</p>
        <p>Based in Beltsville, Maryland.</p>
      </div>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section section--alt" id="contact" aria-labelledby="contact-label">
    <div class="container">
      <SectionMarker num="05" label="PARTNERSHIP / INVESTOR INQUIRIES" id="contact-label" />
      <div class="plain-block">
        <p><a href="mailto:felipe@fariainnovations.com?subject=Faria%20Innovations%20Inquiry">{site.email}</a></p>
        <p><a href={site.phoneHref}>{site.phone}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
