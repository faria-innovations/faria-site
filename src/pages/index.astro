---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMarker from '../components/SectionMarker.astro';
import LabsCartographMap from '../components/LabsCartographMap.astro';
import { ventures } from '../data/ventures';
import { labs } from '../data/labs';
import { site } from '../data/site';
---

<BaseLayout
  title="Faria Innovations — Software, Media, and Experimental Ventures"
  description="Faria Innovations builds and operates software, media, and experimental ventures. Current work: Parcentry (commercial real estate intelligence), Flight Risk (original animated IP), Labs (early-stage experiments)."
>
  <section class="faria-hero hero-split" id="faria-hero" aria-labelledby="faria-hero-title">
    <div class="container hero-split-grid">
      <div class="hero-split-logo">
        <img
          class="hero-logo-lockup"
          src="/assets/faria-hero-lockup.png"
          width="420"
          alt="Faria Innovations"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="hero-split-body">
        <h2 class="faria-hero-title" id="faria-hero-title">
          <em class="faria-name">Faria Innovations</em> builds and operates software, media, and experimental ventures.
        </h2>
        <p class="faria-hero-sub">
          A venture studio turning deep domain expertise into working products. Current work spans commercial real estate intelligence, original animated IP, and early-stage systems&nbsp;— each venture built to operate, not just to demo.
        </p>
        <div class="faria-hero-ctas">
          <a class="cta" href="mailto:felipe@fariainnovations.com?subject=Faria%20Innovations%20Inquiry">Partnership / Investment Inquiry</a>
          <a class="cta cta--ghost" href="#ventures">View Current Ventures&nbsp;→</a>
        </div>
      </div>
    </div>
  </section>

  <section class="faria-proof-row" aria-label="Operating signals">
    <div class="container">
      <ul class="proof-row-list" role="list">
        <li class="proof-row-item">
          <span class="proof-row-num">281,476</span>
          <span class="proof-row-label">Parcels indexed</span>
        </li>
        <li class="proof-row-item">
          <span class="proof-row-num">Nightly</span>
          <span class="proof-row-label">Public-record scans</span>
        </li>
        <li class="proof-row-item">
          <span class="proof-row-num">Original IP</span>
          <span class="proof-row-label">In development</span>
        </li>
        <li class="proof-row-item">
          <span class="proof-row-num">Active</span>
          <span class="proof-row-label">Venture build pipeline</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="registry-meta">
    <dl class="container registry-fields">
      <div class="registry-field"><dt>FILE</dt><dd>{site.legalName}</dd></div>
      <div class="registry-field"><dt>TYPE</dt><dd>PARENT COMPANY / VENTURE INDEX</dd></div>
      <div class="registry-field"><dt>INDEX</dt><dd>PARCENTRY / FLIGHT RISK / LABS</dd></div>
      <div class="registry-field"><dt>LOCATION</dt><dd>BELTSVILLE, MARYLAND</dd></div>
      <div class="registry-field"><dt>LAST FILED</dt><dd>{site.lastUpdated}</dd></div>
    </dl>
  </section>

  <section class="cred-section" id="what-faria-does" aria-labelledby="what-faria-label">
    <div class="container">
      <p class="cred-label" id="what-faria-label">
        <span class="accent-tick" aria-hidden="true">▍</span>
        <span>WHAT FARIA DOES</span>
      </p>
      <ol class="what-list" role="list">
        <li>
          <h3 class="what-list-title">Builds software</h3>
          <p class="what-list-body">Commercial tools with operational use cases.</p>
        </li>
        <li>
          <h3 class="what-list-title">Develops IP</h3>
          <p class="what-list-body">Original worlds, characters, and entertainment concepts.</p>
        </li>
        <li>
          <h3 class="what-list-title">Runs experiments</h3>
          <p class="what-list-body">Small systems and prototypes that may become future ventures.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="ventures-section" id="ventures" aria-labelledby="ventures-label">
    <div class="container dossier-grid">
      <aside class="dossier-opener">
        <span class="dossier-numeral" aria-hidden="true">01</span>
        <p class="dossier-opener-label" id="ventures-label">CURRENT VENTURES</p>
      </aside>

      <ol class="venture-list" role="list">
        {
          ventures.map((v) => (
            <li class={`venture-row venture-row--${v.atmosphere ?? 'standard'}`}>
              <div class="venture-head">
                <p class="venture-category">{v.category}</p>
                <h3 class="venture-name">
                  <a href={v.entry}>{v.name}</a>
                </h3>
                <p class="venture-desc">{v.description}</p>
                {v.expanded && <p class="venture-expanded">{v.expanded}</p>}
              </div>

              <dl class="venture-stage">
                <dt>STAGE</dt>
                <dd>{v.stage}</dd>
              </dl>

              {v.proof && v.proof.length > 0 && (
                <ul class="venture-proof" role="list">
                  {v.proof.map((p) => <li>{p}</li>)}
                </ul>
              )}

              {v.cta && (
                <a class="cta venture-cta" href={v.cta.href}>{v.cta.label}</a>
              )}

              {v.external && (
                <div class="venture-links">
                  <a href={v.external.href} rel="noopener">{v.external.label}</a>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="cred-section" id="operating-proof" aria-labelledby="op-proof-label">
    <div class="container">
      <p class="cred-label" id="op-proof-label">
        <span class="accent-tick" aria-hidden="true">▍</span>
        <span>OPERATING PROOF</span>
      </p>
      <ul class="proof-statement-list" role="list">
        <li>Parcentry is live as an active commercial software build.</li>
        <li>281,476 parcels indexed.</li>
        <li>Nightly public-record scans.</li>
        <li>Flight Risk is an original animated IP in development.</li>
        <li>Labs tracks early experiments and internal systems.</li>
        <li>Faria has a live deployment pipeline and public venture index.</li>
      </ul>
    </div>
  </section>

  <section class="cred-section" id="representative-alert" aria-labelledby="cred-alert-label">
    <div class="container">
      <p class="cred-label" id="cred-alert-label">
        <span class="accent-tick" aria-hidden="true">▍</span>
        <span>REPRESENTATIVE ALERT</span>
      </p>
      <article class="rep-alert">
        <p class="rep-alert-header">
          <span class="accent-tick" aria-hidden="true">●</span>
          <span>ALERT · PARCENTRY</span>
        </p>
        <h3 class="rep-alert-title">OWNERSHIP TRANSFER DETECTED</h3>
        <dl class="rep-alert-fields">
          <div class="rep-alert-row"><dt>Property</dt><dd>Example Commercial Property</dd></div>
          <div class="rep-alert-row"><dt>Market</dt><dd>Nashville, TN</dd></div>
          <div class="rep-alert-row"><dt>Recorded</dt><dd>May 12, 2026</dd></div>
          <div class="rep-alert-row"><dt>Source</dt><dd>County Register of Deeds</dd></div>
        </dl>
        <p class="rep-alert-caption">
          Representative output format. No customer data shown.
        </p>
      </article>
    </div>
  </section>

  <section class="section" id="labs" aria-labelledby="labs-label">
    <div class="container">
      <SectionMarker num="02" label="LABS · WORKING FIELD" id="labs-label" />
      <div class="labs-list">
        {
          labs.map((lab) => (
            <details class="lab-row">
              <summary class="lab-summary">
                <span class="lab-prefix">{lab.prefix}</span>
                <span class="lab-sep" aria-hidden="true">—</span>
                <span class="lab-name">{lab.name}</span>
                <span class="lab-sep" aria-hidden="true">—</span>
                <span class="lab-desc">{lab.description}</span>
              </summary>
              <p class="lab-extra">{lab.expanded}</p>
              {lab.cartograph && <LabsCartographMap />}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-label">
    <div class="container">
      <SectionMarker num="03" label="ABOUT" id="about-label" />
      <div class="plain-block">
        <p>Faria Innovations is operated by Felipe Alves Faria.</p>
        <p>Beltsville, Maryland.</p>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-label">
    <div class="container">
      <SectionMarker num="04" label="CONTACT" id="contact-label" />
      <div class="plain-block">
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={site.phoneHref}>{site.phone}</a></p>
      </div>
    </div>
  </section>

  <section class="invest-line" id="invest" aria-labelledby="invest-label">
    <div class="container">
      <p class="cred-label" id="invest-label">
        <span class="accent-tick" aria-hidden="true">▍</span>
        <span>PARTNERSHIP / INVESTMENT INQUIRIES</span>
      </p>
      <p class="invest-email">
        <a href="mailto:felipe@fariainnovations.com?subject=Faria%20Innovations%20Inquiry">felipe@fariainnovations.com</a>
      </p>
    </div>
  </section>
</BaseLayout>
