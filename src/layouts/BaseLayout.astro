---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = `${site.name} — Venture Index`,
  description = `${site.name} indexes Parcentry, Flight Risk, Labs, and future work by ${site.founder}.`,
  ogType = 'website',
} = Astro.props;

const rawPath = Astro.url.pathname;
let canonical: string;
if (rawPath === '/' || rawPath === '') {
  canonical = site.url;
} else {
  const normalized = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
  canonical = new URL(normalized, site.url).href;
}

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  url: site.url,
  founder: { '@type': 'Person', name: site.founder },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  email: site.email,
  telephone: site.phoneE164,
};

// Build audit stamp — Git SHA + build time, kept in head comment and
// <meta> only. NOT shown in visible UI per design discipline.
const gitSha = (import.meta.env.VERCEL_GIT_COMMIT_SHA ?? '').slice(0, 12);
const buildTime = import.meta.env.VERCEL_GIT_COMMIT_REF
  ? new Date().toISOString()
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gitSha && <meta name="build-sha" content={gitSha} />}
    {buildTime && <meta name="build-time" content={buildTime} />}
    <Fragment set:html={`<!-- build ${gitSha || 'local'} ${buildTime || 'dev'} -->`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.founder} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#00041B" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — notes`} href="/notes/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
