---
// Cartograph mini-map. Thin structural lines, navy ink. Technology only —
// Parcentry + Labs branches (entertainment moved off this site).
---

<figure class="cartograph">
  <svg
    viewBox="0 0 280 180"
    width="280"
    height="180"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Map of Faria Innovations: Parcentry and Labs branches."
  >
    <g stroke="#0A1F44" stroke-width="1" fill="none" stroke-linecap="square">
      <line x1="10" y1="32" x2="10" y2="92" />
      <line x1="10" y1="60" x2="32" y2="60" />
      <line x1="10" y1="92" x2="32" y2="92" />
      <line x1="48" y1="98" x2="48" y2="156" />
      <line x1="48" y1="114" x2="68" y2="114" />
      <line x1="48" y1="135" x2="68" y2="135" />
      <line x1="48" y1="156" x2="68" y2="156" />
    </g>
    <text x="0" y="22" font-family="'Saira', system-ui, sans-serif" font-size="13" font-weight="800" fill="#0A1F44">FARIA</text>
    <text x="40" y="64" font-family="'Helvetica Neue', sans-serif" font-size="11" fill="#64748B">Parcentry</text>
    <text x="40" y="96" font-family="'Helvetica Neue', sans-serif" font-size="11" fill="#64748B">Labs</text>
    <text x="74" y="118" font-family="'IBM Plex Mono', monospace" font-size="10" fill="#64748B">archive</text>
    <text x="74" y="139" font-family="'IBM Plex Mono', monospace" font-size="10" fill="#64748B">fieldnotes</text>
    <text x="74" y="160" font-family="'IBM Plex Mono', monospace" font-size="10" fill="#64748B">cartograph</text>
  </svg>
</figure>
