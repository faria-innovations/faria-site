---
// Cartograph mini-map. Technology ventures and labs branches only.
---

<figure class="cartograph">
  <svg
    viewBox="0 0 280 176"
    width="280"
    height="176"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Map of Faria Innovations: Parcentry and Labs branches."
  >
    <g stroke="#0A1F44" stroke-width="1" fill="none" stroke-linecap="square">
      <!-- main trunk -->
      <line x1="10" y1="32" x2="10" y2="88" />
      <!-- stubs to first-level children -->
      <line x1="10" y1="60" x2="32" y2="60" />
      <line x1="10" y1="88" x2="32" y2="88" />
      <!-- second-level trunk under Labs -->
      <line x1="48" y1="94" x2="48" y2="152" />
      <line x1="48" y1="110" x2="68" y2="110" />
      <line x1="48" y1="131" x2="68" y2="131" />
      <line x1="48" y1="152" x2="68" y2="152" />
    </g>
    <text x="0" y="22" font-family="'Saira', 'Helvetica Neue', sans-serif" font-size="13" font-weight="700" fill="#0A1F44">FARIA</text>
    <text x="40" y="64" font-family="'Helvetica Neue', sans-serif" font-size="11" fill="#6E737C">Parcentry</text>
    <text x="40" y="92" font-family="'Helvetica Neue', sans-serif" font-size="11" fill="#6E737C">Labs</text>
    <text x="74" y="114" font-family="'IBM Plex Mono', monospace" font-size="10" fill="#B8BCC3">archive</text>
    <text x="74" y="135" font-family="'IBM Plex Mono', monospace" font-size="10" fill="#B8BCC3">fieldnotes</text>
    <text x="74" y="156" font-family="'IBM Plex Mono', monospace" font-size="10" fill="#B8BCC3">cartograph</text>
  </svg>
</figure>
