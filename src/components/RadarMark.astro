---
// RadarSignalMark — institutional mark per V3 Identity System Manual.
//
// Motion is done in pure CSS with the "filler-rect + transform-origin:
// center" pattern, which works on every browser back to mobile Safari
// 9 without depending on transform-box: view-box (which iOS Safari < 16
// doesn't support and which broke the sweep on phones).
//
//   • Sweep rotation: wrap the rotating <line> in a <g> containing an
//     invisible 1000×1000 rect. The rect anchors the group's fill-box
//     to the viewBox, so transform-origin: center evaluates to (500,
//     500) regardless of which child is actually drawn.
//   • Ping / pulse / acquisition rings: the circles already have their
//     geometric centre = their fill-box centre, so transform-origin:
//     center pivots correctly with no filler rect needed.
//   • Two blinks (Fi dot, secondary blip) just animate fill-opacity —
//     no transforms involved, works universally.

interface Props {
  /** Rendered pixel size. */
  size?: number;
  /** Optional layout class. */
  class?: string;
}
const { size = 56, class: className = '' } = Astro.props;
---

<svg
  class={`radar-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 1000 1000"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Faria Innovations — Fi detected on radar"
>
  <g fill="none" stroke="#F0EDE4">
    <!-- 4 concentric rings -->
    <circle cx="500" cy="500" r="120" stroke-width="14" />
    <circle cx="500" cy="500" r="240" stroke-width="14" />
    <circle cx="500" cy="500" r="360" stroke-width="14" />
    <circle cx="500" cy="500" r="480" stroke-width="18" />

    <!-- cardinal registration crosses outside the outer ring -->
    <line x1="500" y1="20"  x2="500" y2="68"  stroke-width="14" />
    <line x1="500" y1="932" x2="500" y2="980" stroke-width="14" />
    <line x1="20"  y1="500" x2="68"  y2="500" stroke-width="14" />
    <line x1="932" y1="500" x2="980" y2="500" stroke-width="14" />
  </g>

  <!-- Outer scope frame — four L-shaped corner brackets. -->
  <g class="radar-scope" fill="none" stroke="#F0EDE4" stroke-width="10" opacity="0.85">
    <polyline points="40,120 40,40 120,40" />
    <polyline points="880,40 960,40 960,120" />
    <polyline points="40,880 40,960 120,960" />
    <polyline points="880,960 960,960 960,880" />
  </g>

  <!-- 12-spoke radial grid at 30° increments. -->
  <g class="radar-grid" fill="none" stroke="#F0EDE4" stroke-width="1.5" opacity="0.18">
    <line x1="500" y1="500" x2="500" y2="20"  />
    <line x1="500" y1="500" x2="740" y2="84"  />
    <line x1="500" y1="500" x2="916" y2="260" />
    <line x1="500" y1="500" x2="980" y2="500" />
    <line x1="500" y1="500" x2="916" y2="740" />
    <line x1="500" y1="500" x2="740" y2="916" />
    <line x1="500" y1="500" x2="500" y2="980" />
    <line x1="500" y1="500" x2="260" y2="916" />
    <line x1="500" y1="500" x2="84"  y2="740" />
    <line x1="500" y1="500" x2="20"  y2="500" />
    <line x1="500" y1="500" x2="84"  y2="260" />
    <line x1="500" y1="500" x2="260" y2="84"  />
  </g>

  <!-- Range labels at the SW diagonal of each ring. -->
  <g class="radar-ranges"
     font-family="'IBM Plex Mono','SF Mono',Menlo,monospace"
     font-size="32" font-weight="500" letter-spacing="0"
     fill="#F0EDE4" fill-opacity="0.42"
     text-anchor="middle" dominant-baseline="middle">
    <text x="429" y="571">1</text>
    <text x="344" y="656">2</text>
    <text x="260" y="740">3</text>
    <text x="175" y="825">4</text>
  </g>

  <!-- Outward sonar ping wave from the antenna. The circle's fill-box
       centre = its geometric centre = (500, 500), so transform-origin:
       center pivots correctly. -->
  <circle class="radar-ping" cx="500" cy="500" r="12"
    fill="none" stroke="#F0EDE4" stroke-width="2.5" />
  <circle class="radar-ping radar-ping--echo" cx="500" cy="500" r="12"
    fill="none" stroke="#F0EDE4" stroke-width="2.5" />

  <!-- Antenna mark at the radar centre. -->
  <g class="radar-origin">
    <g stroke="#F0EDE4" stroke-width="2" opacity="0.45">
      <line x1="500" y1="486" x2="500" y2="494" />
      <line x1="500" y1="506" x2="500" y2="514" />
      <line x1="486" y1="500" x2="494" y2="500" />
      <line x1="506" y1="500" x2="514" y2="500" />
    </g>
    <circle cx="500" cy="500" r="6" fill="#F0EDE4" opacity="0.85" />
  </g>

  <!-- Rotating sweep — the filler rect spans the full viewBox so the
       parent <g>'s fill-box matches viewBox. transform-origin: center
       on the parent then evaluates to (500, 500). Works on every
       browser including iOS Safari that lacks transform-box: view-box. -->
  <g class="radar-sweep">
    <rect x="0" y="0" width="1000" height="1000" fill="none" stroke="none"
      pointer-events="none" aria-hidden="true" />
    <line x1="500" y1="500" x2="784" y2="161"
      stroke="#F0EDE4" stroke-width="22" stroke-linecap="round" />
  </g>

  <!-- Secondary unlocked blips. Inner blinks via CSS fill-opacity. -->
  <circle class="radar-blip-secondary"
    cx="732" cy="438" r="9" fill="#F0EDE4" fill-opacity="0.5" />
  <circle cx="133" cy="808" r="9" fill="#F0EDE4" fill-opacity="0.45" />

  <!-- Soft gaussian glow under the Fi dot. -->
  <defs>
    <filter id="fi-glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="10" />
    </filter>
  </defs>
  <circle cx="741" cy="768" r="22" fill="#F0EDE4"
    filter="url(#fi-glow)" opacity="0.55" />

  <!-- Fi blip: filled dot (CSS-blinks via fill-opacity) + two pulse
       rings around it. Circle fill-box centre = geometric centre, so
       transform-origin: center works without a filler rect. -->
  <circle class="fi-dot" cx="741" cy="768" r="18" fill="#F0EDE4" />
  <circle class="radar-pulse" cx="741" cy="768" r="18"
    fill="none" stroke="#F0EDE4" stroke-width="3" />
  <circle class="radar-pulse radar-pulse--echo" cx="741" cy="768" r="18"
    fill="none" stroke="#F0EDE4" stroke-width="3" />

  <!-- Fi acquisition flash, timed to the sweep's 7s cycle. -->
  <circle class="fi-acquire" cx="741" cy="768" r="14"
    fill="none" stroke="#F0EDE4" stroke-width="4" />

  <!-- Navy crosshair cut through the cream blip. -->
  <g stroke="#0A1F44" stroke-width="3" stroke-linecap="butt">
    <line x1="741" y1="755" x2="741" y2="781" />
    <line x1="728" y1="768" x2="754" y2="768" />
  </g>

  <!-- Tight rectilinear lockbox around the blip. -->
  <g fill="none" stroke="#F0EDE4" stroke-width="12">
    <polyline points="706,755 706,733 728,733" />
    <polyline points="754,733 776,733 776,755" />
    <polyline points="706,781 706,803 728,803" />
    <polyline points="754,803 776,803 776,781" />
  </g>

  <!-- Leader tick from the lockbox to the Fi label. -->
  <line class="radar-leader"
    x1="778" y1="768" x2="790" y2="768"
    stroke="#F0EDE4" stroke-width="3" opacity="0.7" />

  <!-- "Fi" label. -->
  <text
    x="792"
    y="790"
    font-family="'Saira', 'Helvetica Neue', system-ui, sans-serif"
    font-weight="900"
    font-style="italic"
    font-size="95"
    letter-spacing="-1"
    fill="#F0EDE4"
  >Fi</text>

  <!-- Polar coordinate stamp under the Fi label. -->
  <text
    class="radar-coords"
    x="792"
    y="836"
    font-family="'IBM Plex Mono','SF Mono',Menlo,monospace"
    font-size="26"
    font-weight="500"
    letter-spacing="1"
    fill="#F0EDE4"
    fill-opacity="0.55"
  >138° · R3</text>
</svg>

<style>
  /* SWEEP — rotate around centre. Filler rect inside .radar-sweep
     anchors its fill-box to the full viewBox, so transform-origin:
     center evaluates to (500, 500). No transform-box needed. */
  .radar-mark .radar-sweep {
    transform-origin: center;
    animation: radar-sweep-rotate 7s linear infinite;
    will-change: transform;
  }
  @keyframes radar-sweep-rotate {
    from { transform: rotate(0deg);   }
    to   { transform: rotate(360deg); }
  }

  /* SONAR PING wave from antenna. The circle's fill-box centre is
     its geometric centre, so transform-origin: center pivots on
     (500, 500). */
  .radar-mark .radar-ping {
    transform-origin: center;
    animation: radar-ping 4s ease-out infinite;
    opacity: 0;
    will-change: transform, opacity;
  }
  .radar-mark .radar-ping--echo {
    animation-delay: -2s;
  }
  @keyframes radar-ping {
    0%   { transform: scale(1);  opacity: 0;    }
    8%   { opacity: 0.45; }
    100% { transform: scale(50); opacity: 0;    }
  }

  /* Fi blip PULSE rings — same circle/fill-box trick. */
  .radar-mark .radar-pulse {
    transform-origin: center;
    animation: radar-pulse 2.6s cubic-bezier(0, 0.55, 0.45, 1) infinite;
    will-change: transform, opacity;
  }
  .radar-mark .radar-pulse--echo {
    animation-delay: -1.3s;
  }
  @keyframes radar-pulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    80%  { opacity: 0; }
    100% { transform: scale(3.6); opacity: 0;   }
  }

  /* Fi ACQUISITION FLASH, locked to the sweep's 7s cycle. Peaks at
     27.2% of the loop when the rotating beam crosses Fi at 138°. */
  .radar-mark .fi-acquire {
    transform-origin: center;
    opacity: 0;
    animation: fi-acquire 7s linear infinite;
    will-change: transform, opacity;
  }
  @keyframes fi-acquire {
    0%, 22%   { transform: scale(1);    opacity: 0;    }
    27%       { transform: scale(1);    opacity: 0.95; }
    36%       { transform: scale(2.4);  opacity: 0;    }
    100%      { transform: scale(1);    opacity: 0;    }
  }

  /* Fi DOT blink — pure fill-opacity, no transform involvement,
     works universally. */
  .radar-mark .fi-dot {
    animation: fi-dot-blink 1.3s ease-in-out infinite;
    will-change: fill-opacity;
  }
  @keyframes fi-dot-blink {
    0%, 100% { fill-opacity: 1;    }
    50%      { fill-opacity: 0.45; }
  }

  /* Secondary blip blink — pure fill-opacity. */
  .radar-mark .radar-blip-secondary {
    animation: radar-blink 4.2s ease-in-out infinite;
    will-change: fill-opacity;
  }
  @keyframes radar-blink {
    0%, 100% { fill-opacity: 0.55; }
    45%, 55% { fill-opacity: 0.12; }
  }

  /* Reduced-motion: stop every animation, hide animated overlays. */
  @media (prefers-reduced-motion: reduce) {
    .radar-mark .radar-sweep,
    .radar-mark .radar-ping,
    .radar-mark .radar-pulse,
    .radar-mark .fi-acquire,
    .radar-mark .fi-dot,
    .radar-mark .radar-blip-secondary {
      animation: none;
    }
    .radar-mark .radar-ping,
    .radar-mark .radar-pulse,
    .radar-mark .fi-acquire {
      opacity: 0;
    }
  }
</style>
