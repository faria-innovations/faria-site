---
// RadarSignalMark — institutional mark per V3 Identity System Manual.
//
// Motion is split between SMIL and CSS by what's safe on every browser:
//   • SMIL (<animate> / <animateTransform>) handles every geometry
//     animation — sweep rotation, ping waves, pulse rings, Fi
//     acquisition flash. SMIL pivots around explicit viewBox points
//     (rotate "0 cx cy") and animates raw attributes (r, opacity),
//     which works on iOS Safari < 16 where `transform-box: view-box`
//     and CSS-on-SVG transform-origins are unreliable.
//   • CSS handles the fill-opacity blinks (Fi dot, secondary blip).
//     These have no transform involvement and are fine on every
//     browser; the CSS path also lets `prefers-reduced-motion: reduce`
//     suppress them cleanly via media query.
//
// Browsers respect OS-level reduced-motion for SMIL automatically.

interface Props {
  /** Rendered pixel size. */
  size?: number;
  /** Optional layout class. */
  class?: string;
}
const { size = 56, class: className = '' } = Astro.props;
---

<svg
  class={`radar-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 1000 1000"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Faria Innovations — Fi detected on radar"
>
  <g fill="none" stroke="#F0EDE4">
    <!-- 4 concentric rings -->
    <circle cx="500" cy="500" r="120" stroke-width="14" />
    <circle cx="500" cy="500" r="240" stroke-width="14" />
    <circle cx="500" cy="500" r="360" stroke-width="14" />
    <circle cx="500" cy="500" r="480" stroke-width="18" />

    <!-- cardinal registration crosses outside the outer ring -->
    <line x1="500" y1="20"  x2="500" y2="68"  stroke-width="14" />
    <line x1="500" y1="932" x2="500" y2="980" stroke-width="14" />
    <line x1="20"  y1="500" x2="68"  y2="500" stroke-width="14" />
    <line x1="932" y1="500" x2="980" y2="500" stroke-width="14" />
  </g>

  <!-- Outer scope frame — four L-shaped corner brackets. -->
  <g class="radar-scope" fill="none" stroke="#F0EDE4" stroke-width="10" opacity="0.85">
    <polyline points="40,120 40,40 120,40" />
    <polyline points="880,40 960,40 960,120" />
    <polyline points="40,880 40,960 120,960" />
    <polyline points="880,960 960,960 960,880" />
  </g>

  <!-- 12-spoke radial grid at 30° increments. -->
  <g class="radar-grid" fill="none" stroke="#F0EDE4" stroke-width="1.5" opacity="0.18">
    <line x1="500" y1="500" x2="500" y2="20"  />
    <line x1="500" y1="500" x2="740" y2="84"  />
    <line x1="500" y1="500" x2="916" y2="260" />
    <line x1="500" y1="500" x2="980" y2="500" />
    <line x1="500" y1="500" x2="916" y2="740" />
    <line x1="500" y1="500" x2="740" y2="916" />
    <line x1="500" y1="500" x2="500" y2="980" />
    <line x1="500" y1="500" x2="260" y2="916" />
    <line x1="500" y1="500" x2="84"  y2="740" />
    <line x1="500" y1="500" x2="20"  y2="500" />
    <line x1="500" y1="500" x2="84"  y2="260" />
    <line x1="500" y1="500" x2="260" y2="84"  />
  </g>

  <!-- Range labels at the SW diagonal of each ring. -->
  <g class="radar-ranges"
     font-family="'IBM Plex Mono','SF Mono',Menlo,monospace"
     font-size="32" font-weight="500" letter-spacing="0"
     fill="#F0EDE4" fill-opacity="0.42"
     text-anchor="middle" dominant-baseline="middle">
    <text x="429" y="571">1</text>
    <text x="344" y="656">2</text>
    <text x="260" y="740">3</text>
    <text x="175" y="825">4</text>
  </g>

  <!-- Outward sonar ping wave from the antenna. SMIL animates r and
       opacity directly so it works on every browser including iOS<16.
       Two rings, second starts at -2s so they interleave. -->
  <circle class="radar-ping" cx="500" cy="500" r="12"
    fill="none" stroke="#F0EDE4" stroke-width="2.5" opacity="0">
    <animate attributeName="r" from="12" to="600"
      dur="4s" repeatCount="indefinite" />
    <animate attributeName="opacity" values="0;0.45;0" keyTimes="0;0.08;1"
      dur="4s" repeatCount="indefinite" />
  </circle>
  <circle class="radar-ping" cx="500" cy="500" r="12"
    fill="none" stroke="#F0EDE4" stroke-width="2.5" opacity="0">
    <animate attributeName="r" from="12" to="600"
      dur="4s" begin="-2s" repeatCount="indefinite" />
    <animate attributeName="opacity" values="0;0.45;0" keyTimes="0;0.08;1"
      dur="4s" begin="-2s" repeatCount="indefinite" />
  </circle>

  <!-- Antenna mark at the radar centre. -->
  <g class="radar-origin">
    <g stroke="#F0EDE4" stroke-width="2" opacity="0.45">
      <line x1="500" y1="486" x2="500" y2="494" />
      <line x1="500" y1="506" x2="500" y2="514" />
      <line x1="486" y1="500" x2="494" y2="500" />
      <line x1="506" y1="500" x2="514" y2="500" />
    </g>
    <circle cx="500" cy="500" r="6" fill="#F0EDE4" opacity="0.85" />
  </g>

  <!-- Rotating sweep — SMIL rotate "0 500 500" → "360 500 500" pivots
       exactly on viewBox centre on every browser. -->
  <g class="radar-sweep" fill="none" stroke="#F0EDE4">
    <line x1="500" y1="500" x2="784" y2="161" stroke-width="22"
      stroke-linecap="round" />
    <animateTransform attributeName="transform" type="rotate"
      from="0 500 500" to="360 500 500"
      dur="7s" repeatCount="indefinite" />
  </g>

  <!-- Secondary unlocked blips. Inner blinks via CSS (no transform). -->
  <circle class="radar-blip-secondary"
    cx="732" cy="438" r="9" fill="#F0EDE4" fill-opacity="0.5" />
  <circle cx="133" cy="808" r="9" fill="#F0EDE4" fill-opacity="0.45" />

  <!-- Soft gaussian glow under the Fi dot. -->
  <defs>
    <filter id="fi-glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="10" />
    </filter>
  </defs>
  <circle cx="741" cy="768" r="22" fill="#F0EDE4"
    filter="url(#fi-glow)" opacity="0.55" />

  <!-- Fi blip: filled dot (CSS-blinks via fill-opacity) + two SMIL
       ping rings around it. -->
  <circle class="fi-dot" cx="741" cy="768" r="18" fill="#F0EDE4" />
  <circle class="radar-pulse" cx="741" cy="768" r="18"
    fill="none" stroke="#F0EDE4" stroke-width="3" opacity="0">
    <animate attributeName="r" from="18" to="65"
      dur="2.6s" repeatCount="indefinite" />
    <animate attributeName="opacity" values="0.7;0;0" keyTimes="0;0.8;1"
      dur="2.6s" repeatCount="indefinite" />
  </circle>
  <circle class="radar-pulse" cx="741" cy="768" r="18"
    fill="none" stroke="#F0EDE4" stroke-width="3" opacity="0">
    <animate attributeName="r" from="18" to="65"
      dur="2.6s" begin="-1.3s" repeatCount="indefinite" />
    <animate attributeName="opacity" values="0.7;0;0" keyTimes="0;0.8;1"
      dur="2.6s" begin="-1.3s" repeatCount="indefinite" />
  </circle>

  <!-- Fi acquisition flash, locked to the sweep's 7s cycle so the
       flash peaks at 27.2% of the loop (when the rotating beam
       crosses Fi at polar 138°). -->
  <circle class="fi-acquire" cx="741" cy="768" r="14"
    fill="none" stroke="#F0EDE4" stroke-width="4" opacity="0">
    <animate attributeName="r"
      values="14;14;14;33;14"
      keyTimes="0;0.22;0.27;0.36;1"
      dur="7s" repeatCount="indefinite" />
    <animate attributeName="opacity"
      values="0;0;0.95;0;0"
      keyTimes="0;0.22;0.27;0.36;1"
      dur="7s" repeatCount="indefinite" />
  </circle>

  <!-- Navy crosshair cut through the cream blip. -->
  <g stroke="#0A1F44" stroke-width="3" stroke-linecap="butt">
    <line x1="741" y1="755" x2="741" y2="781" />
    <line x1="728" y1="768" x2="754" y2="768" />
  </g>

  <!-- Tight rectilinear lockbox around the blip. -->
  <g fill="none" stroke="#F0EDE4" stroke-width="12">
    <polyline points="706,755 706,733 728,733" />
    <polyline points="754,733 776,733 776,755" />
    <polyline points="706,781 706,803 728,803" />
    <polyline points="754,803 776,803 776,781" />
  </g>

  <!-- Leader tick from the lockbox to the Fi label. -->
  <line class="radar-leader"
    x1="778" y1="768" x2="790" y2="768"
    stroke="#F0EDE4" stroke-width="3" opacity="0.7" />

  <!-- "Fi" label. -->
  <text
    x="792"
    y="790"
    font-family="'Saira', 'Helvetica Neue', system-ui, sans-serif"
    font-weight="900"
    font-style="italic"
    font-size="95"
    letter-spacing="-1"
    fill="#F0EDE4"
  >Fi</text>

  <!-- Polar coordinate stamp under the Fi label. -->
  <text
    class="radar-coords"
    x="792"
    y="836"
    font-family="'IBM Plex Mono','SF Mono',Menlo,monospace"
    font-size="26"
    font-weight="500"
    letter-spacing="1"
    fill="#F0EDE4"
    fill-opacity="0.55"
  >138° · R3</text>
</svg>

<style>
  /* CSS-driven fill-opacity blinks. No transform-origin or
     transform-box involved, so these work identically on every
     browser including older iOS Safari. */

  .radar-mark .fi-dot {
    animation: fi-dot-blink 1.3s ease-in-out infinite;
    will-change: fill-opacity;
  }
  @keyframes fi-dot-blink {
    0%, 100% { fill-opacity: 1;    }
    50%      { fill-opacity: 0.45; }
  }

  .radar-mark .radar-blip-secondary {
    animation: radar-blink 4.2s ease-in-out infinite;
    will-change: fill-opacity;
  }
  @keyframes radar-blink {
    0%, 100% { fill-opacity: 0.55; }
    45%, 55% { fill-opacity: 0.12; }
  }

  /* Reduced-motion fallback. Stops the two CSS blinks at full
     opacity. SMIL animations are stopped by the inline script in
     BaseLayout (svg.pauseAnimations() on every <svg> in radar). */
  @media (prefers-reduced-motion: reduce) {
    .radar-mark .fi-dot,
    .radar-mark .radar-blip-secondary {
      animation: none;
    }
  }
</style>
