---
// RadarSignalMark — single-color navy construction. No red. No glow.
// 4 concentric rings, sweep line 40° clockwise from vertical, off-center
// Fi signal on ring 3 with rectilinear corner-bracket registration, and
// cardinal registration crosses outside the outer ring. All strokes are
// heavy enough to read like a print-engraved signal diagram at small
// render sizes.

interface Props {
  /** Rendered pixel size. Default tuned for masthead. */
  size?: number;
  /** Optional class for layout hook. */
  class?: string;
}
const { size = 44, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 1000 1000"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Faria Innovations — signal mark"
>
  <g fill="none" stroke="#0A1F44">
    <!-- 4 concentric rings, radii 120 / 240 / 360 / 480 -->
    <circle cx="500" cy="500" r="120" stroke-width="14" />
    <circle cx="500" cy="500" r="240" stroke-width="14" />
    <circle cx="500" cy="500" r="360" stroke-width="14" />
    <circle cx="500" cy="500" r="480" stroke-width="18" />

    <!-- sweep line: 40° clockwise from vertical, ends at 92% of outer radius
         end = (500 + 0.92*480*sin40°, 500 - 0.92*480*cos40°)
             = (500 + 284, 500 - 339) = (784, 161) -->
    <line x1="500" y1="500" x2="784" y2="161" stroke-width="22" />

    <!-- cardinal registration crosses (outside the outer ring) -->
    <line x1="500" y1="20"  x2="500" y2="68"  stroke-width="14" />
    <line x1="500" y1="932" x2="500" y2="980" stroke-width="14" />
    <line x1="20"  y1="500" x2="68"  y2="500" stroke-width="14" />
    <line x1="932" y1="500" x2="980" y2="500" stroke-width="14" />

    <!-- registration bracket around the Fi signal — rectilinear corners,
         not a full rect. Bracket centered on the blip area, ~18% of width. -->
    <polyline points="640,720 640,672 692,672" stroke-width="14" />
    <polyline points="770,672 822,672 822,720" stroke-width="14" />
    <polyline points="640,794 640,842 692,842" stroke-width="14" />
    <polyline points="770,842 822,842 822,794" stroke-width="14" />
  </g>

  <!-- Fi blip: small navy dot at polar (138°, 72% outer radius)
       x = 500 + 0.72*480*sin138° = 500 + 231 = 731
       y = 500 - 0.72*480*cos138° = 500 + 257 = 757 — but we lift it slightly
       so the bracket frames both the dot and the label cleanly. -->
  <circle cx="731" cy="712" r="14" fill="#0A1F44" />

  <!-- Fi label inside the bracket -->
  <text
    x="731"
    y="816"
    text-anchor="middle"
    font-family="'Saira', 'Helvetica Neue', system-ui, sans-serif"
    font-weight="900"
    font-style="italic"
    font-size="86"
    fill="#0A1F44"
  >Fi</text>
</svg>
