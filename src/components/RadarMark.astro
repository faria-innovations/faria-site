---
// RadarSignalMark — Fi as acquired target on the radar.
// 4 concentric navy rings, sweep line aimed at the detection point,
// off-center Fi blip sitting on ring 3 at polar 138°, rectilinear
// lockbox / corner-bracket framing a readable path-based Fi glyph
// (matches the engineered Fi identity), and a tiny mono annotation
// — FI-01 ACQUIRED. Single-color navy. No glow. No animation.

interface Props {
  /** Rendered pixel size. Tuned for masthead at 48; OG scales up. */
  size?: number;
  /** Optional layout class. */
  class?: string;
}
const { size = 60, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 1000 1000"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Faria Innovations — Fi acquired"
>
  <!-- 4 concentric rings (radii 120 / 240 / 360 / 480) -->
  <g fill="none" stroke="#0A1F44">
    <circle cx="500" cy="500" r="120" stroke-width="14" />
    <circle cx="500" cy="500" r="240" stroke-width="14" />
    <circle cx="500" cy="500" r="360" stroke-width="14" />
    <circle cx="500" cy="500" r="480" stroke-width="18" />

    <!-- sweep line: leader pointing at the acquired Fi target. Stops
         just outside the upper-left corner of the lockbox (which
         starts at 681,712) so the 22-stroke navy line never enters
         the box and never cuts the Fi glyph. -->
    <line x1="500" y1="500" x2="670" y2="700" stroke-width="22" />

    <!-- cardinal registration crosses outside the outer ring -->
    <line x1="500" y1="20"  x2="500" y2="68"  stroke-width="14" />
    <line x1="500" y1="932" x2="500" y2="980" stroke-width="14" />
    <line x1="20"  y1="500" x2="68"  y2="500" stroke-width="14" />
    <line x1="932" y1="500" x2="980" y2="500" stroke-width="14" />
  </g>

  <!-- Acquisition lockbox — rectilinear corner brackets centered on
       polar 138° at radius 420 (between rings 3 and 4). Size: 200×200
       viewBox units. The Fi glyph inside is now the entire detected
       signal — a standalone blip dot would only crowd it at masthead
       scale. -->
  <g fill="none" stroke="#0A1F44" stroke-width="16">
    <polyline points="681,762 681,712 731,712" />
    <polyline points="831,712 881,712 881,762" />
    <polyline points="681,862 681,912 731,912" />
    <polyline points="831,912 881,912 881,862" />
  </g>

  <!-- Fi glyph inside the lockbox — fills ~90% of the box vertically
       so the letters survive masthead scale. Same engineered F + i as
       the footer / favicon, with heavier strokes for radar legibility. -->
  <g fill="none" stroke="#0A1F44" stroke-width="38" stroke-linecap="square">
    <!-- F: stem -->
    <line x1="720" y1="739" x2="720" y2="885" />
    <!-- F: top arm -->
    <line x1="720" y1="739" x2="798" y2="739" />
    <!-- F: crossbar -->
    <line x1="720" y1="805" x2="778" y2="805" />
  </g>
  <g fill="#0A1F44">
    <!-- i: stem -->
    <rect x="836" y="790" width="26" height="95" />
    <!-- i: tittle -->
    <rect x="836" y="735" width="26" height="26" />
  </g>

  <!-- Tiny mono annotation: FI-01 ACQUIRED -->
  <text
    x="681"
    y="688"
    font-family="'IBM Plex Mono', 'SF Mono', Menlo, monospace"
    font-weight="600"
    font-size="34"
    letter-spacing="3"
    fill="#0A1F44"
  >FI-01 ACQUIRED</text>
</svg>
