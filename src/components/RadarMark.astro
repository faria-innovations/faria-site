---
// RadarSignalMark — institutional mark per V3 Identity System Manual.
//
// Motion (cumulative across passes):
//   • Sweep rotates clockwise on a 7s linear loop.
//   • Fi blip emits two staggered ping rings (the second echoes the first).
//   • Subtle gaussian glow under the Fi dot, so it reads as an active
//     signal rather than a static mark.
//   • prefers-reduced-motion stops every animation and hides the pings;
//     the static composition matches the favicon / OG render.

interface Props {
  /** Rendered pixel size. */
  size?: number;
  /** Optional layout class. */
  class?: string;
}
const { size = 56, class: className = '' } = Astro.props;
---

<svg
  class={`radar-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 1000 1000"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Faria Innovations — Fi detected on radar"
>
  <g fill="none" stroke="#F0EDE4">
    <!-- 4 concentric rings -->
    <circle cx="500" cy="500" r="120" stroke-width="14" />
    <circle cx="500" cy="500" r="240" stroke-width="14" />
    <circle cx="500" cy="500" r="360" stroke-width="14" />
    <circle cx="500" cy="500" r="480" stroke-width="18" />

    <!-- cardinal registration crosses outside the outer ring -->
    <line x1="500" y1="20"  x2="500" y2="68"  stroke-width="14" />
    <line x1="500" y1="932" x2="500" y2="980" stroke-width="14" />
    <line x1="20"  y1="500" x2="68"  y2="500" stroke-width="14" />
    <line x1="932" y1="500" x2="980" y2="500" stroke-width="14" />
  </g>

  <!-- Phase 4 shape: outer scope frame. Four L-shaped corner brackets
       — the lockbox idiom recast at the radar's outer scale. Slight
       opacity drop so the rings still dominate the silhouette while
       the frame supplies tactical containment. -->
  <g class="radar-scope" fill="none" stroke="#F0EDE4" stroke-width="10" opacity="0.85">
    <polyline points="40,120 40,40 120,40" />
    <polyline points="880,40 960,40 960,120" />
    <polyline points="40,880 40,960 120,960" />
    <polyline points="880,960 960,960 960,880" />
  </g>

  <!-- Phase 2 density: 12-spoke radial grid at 30° increments. Rendered
       behind the sweep so the comet trail passes over it. Stroke is the
       same cream as everything else but dropped to 0.18 opacity so it
       reads as background scale, not foreground geometry. -->
  <g class="radar-grid" fill="none" stroke="#F0EDE4" stroke-width="1.5" opacity="0.18">
    <line x1="500" y1="500" x2="500" y2="20"  />
    <line x1="500" y1="500" x2="740" y2="84"  />
    <line x1="500" y1="500" x2="916" y2="260" />
    <line x1="500" y1="500" x2="980" y2="500" />
    <line x1="500" y1="500" x2="916" y2="740" />
    <line x1="500" y1="500" x2="740" y2="916" />
    <line x1="500" y1="500" x2="500" y2="980" />
    <line x1="500" y1="500" x2="260" y2="916" />
    <line x1="500" y1="500" x2="84"  y2="740" />
    <line x1="500" y1="500" x2="20"  y2="500" />
    <line x1="500" y1="500" x2="84"  y2="260" />
    <line x1="500" y1="500" x2="260" y2="84"  />
  </g>

  <!-- Phase 2 density: range labels at the SW diagonal of each ring.
       Mono digits inset slightly from each ring so they read as
       "this ring is range N." -->
  <g class="radar-ranges"
     font-family="'IBM Plex Mono','SF Mono',Menlo,monospace"
     font-size="32" font-weight="500" letter-spacing="0"
     fill="#F0EDE4" fill-opacity="0.42"
     text-anchor="middle" dominant-baseline="middle">
    <text x="429" y="571">1</text>
    <text x="344" y="656">2</text>
    <text x="260" y="740">3</text>
    <text x="175" y="825">4</text>
  </g>

  <!-- Antenna mark at the radar centre — small filled dot plus four
       micro-ticks so the origin reads as an engineered emitter, not a
       stray pixel. Sits beneath the sweep so the beam passes over it. -->
  <g class="radar-origin">
    <g stroke="#F0EDE4" stroke-width="2" opacity="0.45">
      <line x1="500" y1="486" x2="500" y2="494" />
      <line x1="500" y1="506" x2="500" y2="514" />
      <line x1="486" y1="500" x2="494" y2="500" />
      <line x1="506" y1="500" x2="514" y2="500" />
    </g>
    <circle cx="500" cy="500" r="6" fill="#F0EDE4" opacity="0.85" />
  </g>

  <!-- Rotating sweep — single clean stroke. The rotation alone is the
       "active scan" reading; no trailing comet. -->
  <g class="radar-sweep" fill="none" stroke="#F0EDE4">
    <line x1="500" y1="500" x2="784" y2="161" stroke-width="22"
      stroke-linecap="round" />
  </g>

  <!-- Phase 3 narrative: secondary unlocked blips. Faria is tracking
       more than one venture; Fi is the acquired contact, these are
       the others in the field. Smaller, no lockbox, dimmer fill. -->
  <circle cx="732" cy="438" r="9"  fill="#F0EDE4" fill-opacity="0.5"  />
  <circle cx="133" cy="808" r="9"  fill="#F0EDE4" fill-opacity="0.45" />

  <!-- Soft gaussian glow under the Fi dot so the contact reads as an
       active signal rather than a flat mark. Filter blurs a slightly
       larger copy of the blip; the actual dot sits on top. -->
  <defs>
    <filter id="fi-glow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="10" />
    </filter>
  </defs>
  <circle cx="741" cy="768" r="22" fill="#F0EDE4"
    filter="url(#fi-glow)" opacity="0.55" />

  <!-- Fi blip: filled dot + two staggered ping rings (the echo). -->
  <circle cx="741" cy="768" r="18" fill="#F0EDE4" />
  <circle class="radar-pulse" cx="741" cy="768" r="18"
    fill="none" stroke="#F0EDE4" stroke-width="3" />
  <circle class="radar-pulse radar-pulse--echo" cx="741" cy="768" r="18"
    fill="none" stroke="#F0EDE4" stroke-width="3" />

  <!-- Phase 3 narrative: navy crosshair cut through the cream blip
       turns the dot into a target reticle. Drawn in #0A1F44 (paper
       field) so it reads as a notch in the cream, not a layer on top. -->
  <g stroke="#0A1F44" stroke-width="3" stroke-linecap="butt">
    <line x1="741" y1="755" x2="741" y2="781" />
    <line x1="728" y1="768" x2="754" y2="768" />
  </g>

  <!-- Tight rectilinear lockbox around the blip — corner brackets only,
       ≈ 70 viewBox units across, centered on (741, 768). -->
  <g fill="none" stroke="#F0EDE4" stroke-width="12">
    <polyline points="706,755 706,733 728,733" />
    <polyline points="754,733 776,733 776,755" />
    <polyline points="706,781 706,803 728,803" />
    <polyline points="754,803 776,803 776,781" />
  </g>

  <!-- Phase 3 narrative: leader tick from the lockbox to the Fi label.
       Reads "this is what this label is annotating." -->
  <line class="radar-leader"
    x1="778" y1="768" x2="790" y2="768"
    stroke="#F0EDE4" stroke-width="3" opacity="0.7" />

  <!-- "Fi" label sat to the right of the lockbox in the safe corridor. -->
  <text
    x="792"
    y="790"
    font-family="'Saira', 'Helvetica Neue', system-ui, sans-serif"
    font-weight="900"
    font-style="italic"
    font-size="95"
    letter-spacing="-1"
    fill="#F0EDE4"
  >Fi</text>

  <!-- Phase 2 density: polar coordinate stamp under the Fi label.
       The blip sits at ring 3, polar 138° from north — those are the
       contact's actual coordinates in the grid above, so the stamp is
       genuine telemetry, not decoration. -->
  <text
    class="radar-coords"
    x="792"
    y="836"
    font-family="'IBM Plex Mono','SF Mono',Menlo,monospace"
    font-size="26"
    font-weight="500"
    letter-spacing="1"
    fill="#F0EDE4"
    fill-opacity="0.55"
  >138° · R3</text>
</svg>

<style>
  /* The sweep rotates around the radar centre (500,500 in viewBox space).
     transform-box: view-box maps transform-origin to the SVG's
     coordinate system so the rotation pivots exactly on the centre. */
  .radar-mark .radar-sweep {
    transform-box: view-box;
    transform-origin: 500px 500px;
    animation: radar-sweep-rotate 7s linear infinite;
    will-change: transform;
  }
  @keyframes radar-sweep-rotate {
    from { transform: rotate(0deg);   }
    to   { transform: rotate(360deg); }
  }

  /* Fi blip "ping" — outer ring expands and fades on a slow loop.
     The echo variant runs the same animation offset by half the
     period so the two rings interleave: while one fades, the next is
     just starting. */
  .radar-mark .radar-pulse {
    transform-box: view-box;
    transform-origin: 741px 768px;
    animation: radar-pulse 2.6s cubic-bezier(0, 0.55, 0.45, 1) infinite;
    will-change: transform, opacity;
  }
  .radar-mark .radar-pulse--echo {
    animation-delay: -1.3s;
  }
  @keyframes radar-pulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    80%  { opacity: 0; }
    100% { transform: scale(3.6); opacity: 0;   }
  }

  /* Respect reduced motion: stop every animation and hide the pulse
     rings entirely. The static composition is identical to favicon/OG. */
  @media (prefers-reduced-motion: reduce) {
    .radar-mark .radar-sweep,
    .radar-mark .radar-pulse {
      animation: none;
    }
    .radar-mark .radar-pulse {
      opacity: 0;
    }
  }
</style>
