---
// RadarSignalMark — institutional mark per V3 Identity System Manual.
// Fi reads as a detected signal: a small navy blip dot on ring 3 at
// polar 138°, framed by a tight rectilinear lockbox, with the "Fi"
// label set immediately to the right of the lockbox.
//
// Geometry follows the spec:
//   • 4 concentric rings (linear spacing)
//   • sweep 40° clockwise from vertical, endpoint at 92% outer radius
//   • Fi blip on ring 3, polar 138°
//   • lockbox: rectilinear corner brackets ≈ 70 viewBox units
//   • Fi label: heavy italic Saira to the right of the lockbox

interface Props {
  /** Rendered pixel size. */
  size?: number;
  /** Optional layout class. */
  class?: string;
}
const { size = 56, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 1000 1000"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Faria Innovations — Fi detected on radar"
>
  <g fill="none" stroke="#0A1F44">
    <!-- 4 concentric rings -->
    <circle cx="500" cy="500" r="120" stroke-width="14" />
    <circle cx="500" cy="500" r="240" stroke-width="14" />
    <circle cx="500" cy="500" r="360" stroke-width="14" />
    <circle cx="500" cy="500" r="480" stroke-width="18" />

    <!-- sweep: 40° clockwise from vertical (upper-right quadrant),
         length 92% of outer radius
         end = (500 + 0.92·480·sin40°, 500 - 0.92·480·cos40°)
             = (500 + 284, 500 - 339) = (784, 161) -->
    <line x1="500" y1="500" x2="784" y2="161" stroke-width="22" />

    <!-- cardinal registration crosses outside the outer ring -->
    <line x1="500" y1="20"  x2="500" y2="68"  stroke-width="14" />
    <line x1="500" y1="932" x2="500" y2="980" stroke-width="14" />
    <line x1="20"  y1="500" x2="68"  y2="500" stroke-width="14" />
    <line x1="932" y1="500" x2="980" y2="500" stroke-width="14" />
  </g>

  <!-- Fi blip: small navy dot on ring 3 at polar 138°.
       (500 + 360·sin138°, 500 - 360·cos138°) = (741, 768) -->
  <circle cx="741" cy="768" r="18" fill="#0A1F44" />

  <!-- Tight rectilinear lockbox around the blip — corner brackets only,
       ≈ 70 viewBox units across, centered on (741, 768). -->
  <g fill="none" stroke="#0A1F44" stroke-width="12">
    <polyline points="706,755 706,733 728,733" />
    <polyline points="754,733 776,733 776,755" />
    <polyline points="706,781 706,803 728,803" />
    <polyline points="754,803 776,803 776,781" />
  </g>

  <!-- "Fi" label, centered just below the lockbox in the safe band
       y > ring-3 max (860) and outside ring-4's right edge at that band.
       Sitting here keeps the letterforms clear of every ring stroke at
       masthead scale, while staying visually associated with the
       lockbox above it. -->
  <text
    x="720"
    y="890"
    text-anchor="middle"
    font-family="'Saira', 'Helvetica Neue', system-ui, sans-serif"
    font-weight="900"
    font-style="italic"
    font-size="100"
    letter-spacing="-1"
    fill="#0A1F44"
  >Fi</text>
</svg>
