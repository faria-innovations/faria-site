---
import FiBadge from './FiBadge.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const stamp = 'BELTSVILLE, MARYLAND';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <p class="footer-meta">{stamp}</p>
      <FiBadge size={32} />
    </div>
    <p class="footer-legal">© {year} FARIA INNOVATIONS LLC · PATENTS PENDING</p>
  </div>
</footer>
