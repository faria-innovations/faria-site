---
import FiBadge from './FiBadge.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
// site.lastUpdated is YYYY-MM-DD → footer stamp is MM.YYYY
const [issYear, issMonth] = site.lastUpdated.split('-');
const issued = `${issMonth}.${issYear}`;
const stamp = `SYSTEM VERSION 3.0 · ISSUED ${issued} · BELTSVILLE, MARYLAND`;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <p class="footer-meta">{stamp}</p>
      <FiBadge size={32} />
    </div>
    <p class="footer-legal">© {year} Faria Innovations LLC · Patents Pending</p>
  </div>
</footer>
