---
import FiBadge from './FiBadge.astro';
import FariaWordmark from './FariaWordmark.astro';
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="header-lockup" href="/" aria-label="Faria Innovations — home">
      <FiBadge size={42} class="header-fi" />
      <FariaWordmark width={168} class="header-wordmark" label="Faria Innovations" />
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/#products">Products</a>
      <a href="/#labs">Labs</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>
