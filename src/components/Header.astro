---
import FariaWordmark from './FariaWordmark.astro';
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="header-lockup" href="/" aria-label="Faria Innovations — home">
      <img
        class="header-cube"
        src="/assets/faria-cube-logo.png"
        width="56"
        height="56"
        alt=""
        aria-hidden="true"
        decoding="async"
      />
      <FariaWordmark width={172} class="header-wordmark" />
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/#ventures">Ventures</a>
      <a href="/#labs">Labs</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>
